integer cnt_ar_incr_len256 = 0;
always_ff @(posedge aclk)
  if (aresetn && cov_hit_ar_incr_len256) cnt_ar_incr_len256 <= cnt_ar_incr_len256 + 1;
`endif

// ---- ar_size0: read address: 1-byte beats
//      ar_size0_ev
`ifdef AXI_COVER_SVA
c_ar_size0 : cover property (@(posedge aclk) disable iff (!aresetn) ar_size0_ev);
