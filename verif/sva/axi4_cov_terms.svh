wire aw_stall0    = awvalid & ~awready & ~aw_pend_q;     // first stalled cycle of a transfer
wire aw_hold      = awvalid & ~awready &  aw_pend_q;     // a continuing stall
wire aw_hs_after_stall  = aw_hs &  aw_pend_q;
